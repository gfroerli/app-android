<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions for maplibre integration. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Permission to use the map-based templates of the Car App Library. -->
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:name=".GfroerliApplication"
        android:icon="@mipmap/app_icon"
        android:theme="@style/AppTheme">

        <!-- Primary activity -->
        <activity
            android:name=".activities.map.MapActivity"
            android:icon="@mipmap/app_icon"
            android:exported="true"
            android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Other activities -->
        <activity
            android:name=".activities.AboutActivity"
            android:label="@string/activity_about"
            android:parentActivityName=".activities.map.MapActivity"
            android:exported="false" />

        <!-- Android Auto integration (Car App Library, POI category) -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />
        <!-- The service must be exported so that the car host can bind to it.
             Access is restricted through a HostValidator instead of a permission. -->
        <service
            android:name=".car.GfroerliCarAppService"
            android:exported="true"
            android:label="@string/app_name"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>

    </application>

</manifest>